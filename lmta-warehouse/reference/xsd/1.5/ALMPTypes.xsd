					<xsd:documentation xml:lang="en-ca">New Brunswick</xsd:documentation>
					<xsd:documentation xml:lang="fr-ca">Nouveau-Brunswick</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
