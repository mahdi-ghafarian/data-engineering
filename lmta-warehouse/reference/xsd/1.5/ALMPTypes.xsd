<?xml version="1.0" encoding="utf-8"?>
<xsd:schema xmlns="http://servicecanada.gc.ca/ALMP/contentTypes"
 xmlns:xsd="http://www.w3.org/2001/XMLSchema"
 targetNamespace="http://servicecanada.gc.ca/ALMP/contentTypes">

	<xsd:annotation>
		<xsd:documentation xml:lang="en-CA">
      r1.0 2011-11-04     Initial release.
      r1.1 2012-01-18     Added simpleType "actionPlanResultCodeValue.2012".
      r1.2 2014-08-27     Added French description for "adressType";"sysAction xsd:positiveInteger";"lenght.1-30" and "systemType".
      r1.3 2018-01-17     Added codes 13 to 16 for educationCodeValue.
      Added code 9 for languagesSpokenCodeValue, maritalStatusCodeValue, genderCodeValue.
      Changed disabilityCodeValue type for integer 0, 1, 9.
      Added code 8 for actionPlanResultCodeValue.
      Added simpleType indigenousIdentityCodeValue, immigrationStatusCodeValue, visibleMinorityCodeValue.
      , actionPlanPreviousEmploymentCodeValue, actionPlanPrecariousEmploymentCodeValue.
      , interventionCredentialCodeValue, interventionEssentialSkillsCodeValue, provincialOfficeTypeCode.
      Added codes for interventionCodeValue 111, 112, 113, 114, 211, 212,  213, 214, 215, 221, 222, 223, 224, 311.
      Added simpleType APEndDate.
      Added more detail in streetAddress regarding apartment number.
      r1.4 2018-01-25     Changed the postal code to accept lowercase letters per task 163372.
      Updated description as well.
      r1.5 2018-05-24     Added the option ''Unknown'' to the immigrationStatusCodeValue element.
      Modified the french for the ''self-employed'' option to ''travailleur independant'' so that it is consistant for all elements: actionPlanPreviousEmploymentCodeValue, actionPlanResultCodeValue.
      r1.6 2018-11-07     Modified interventionCredentialCodeValue element to add the option "Not Applicable".
      Modified the "unknown" option to include "For exclusive use by LMTA during the transition period."
      Added information on exclusivity for ILMP and LMTA elements.
      Added information on which element is mandatory, for which program (LMTA vs. ILMP), and if they are validated on the server side.
      Modified actionPlanPreviousEmploymentCode element to add the option "Unknown".
      r1.7 2018-12-04     Modified string types to token to TRIM white spaces.
      Modified "length.1-30" and changed its name to "basicLengthString"
      Modified all enumerations to stop empty elements.
      Added Unknown to languagesSpokenCodeValue, interventionEssentialSkillsCodeValue, visibleMinorityCodeValue.
      Modified actionPlanPreviousEmploymentCodeValue, added option 9.
      Added element scheduleTypeCodeValue.
      r1.8 2018-12-18     Added 'unknown' to elements: maritalStatusCodeValue, educationCodeValue.
      Changed all references to 'aboriginal' for 'indigenous' in the documentations.
      Added the type NOCVersionValue for the elements: actionPlanPreviousEmploymentNOCVersion, actionPlanResultRelatedNOCVersion, NOCVersion.
      Added the type shortLengthString for the elements: actionPlanID, interventionID.
      Added the type longLengthString for the elements: educationLevelComment, interventionTitle.
      r1.9 2019-01-10     Changed actionPlanPreviousEmploymentCodeValue value 8 to value 10 (unknown).
      Simplified all patterns in schema.
      r2.0 2019-01-17     Final version for LMTA and ILMP.
      r2.1 2019-02-18     Changed contactPhoneNumber to optional.
      r2.2 2019-05-10     Modified sysComment to 100 max value.
      Modified systemType for sysAction.
      r2.3 2020-06-30     Fixed and issue with the systemType.
      r2.4 2021-06-01     Modified phone number validation to allow new numbers to pass through.
      r2.5 2021-07-20     Modified bypass values from "unknown" to "not available".
      Added bypass values to the following elements: interventionCredentialCodeValue, provinceList, indigenousIdentityCodeValue.
      Added bypass value to disability element.
      r2.6 2022-05-24		Added 2021 option to NOCVersionValue element.
      Added new type "NOCValueCode".
      r2.6 2025-11-24		Added option 'Work-sharing' to elements: actionPlanResultCodeValue, actionPlanPreviousEmploymentCodeValue.
      Added new type actionPlanFundingSourceCodeValue.
      Added new type actionPlanFollowUpResultCodeValue.
      Added new type interventionCostCategoryCodeValue.
      Added the type NAICSValueCode for the elements: actionPlanPreviousEmploymentNAICS, actionPlanTargetNAICS, actionPlanFollowUpNAICS.
      Added the type NAICSVersionValue for the elements: actionPlanPreviousEmploymentNAICSVersion, actionPlanTargetNAICSVersion, actionPlanFollowUpNAICSVersion.
      Added the type payRateValue for the elements: actionPlanPreviousEmploymentPayRate, actionPlanFollowUpEmploymentPayRate.
      Added the type employmentHoursType for the elements: actionPlanPreviousEmploymentHours, actionPlanFollowUpEmploymentHours.
    </xsd:documentation>
		<xsd:documentation xml:lang="fr-CA">
      r1.0 2011-11-04     Relâche initiale.
      r1.1 2012-01-18     Ajout de simpleType "actionPlanResultCodeValue.2012".
      r1.2 2014-08-27     Ajout de description en français pour "addressType";"sysAction xsd:positiveInteger";"lenght.1-30" et "systemType".
      r1.3 2018-01-17     Ajout de codes 13 à 16 pour educationCodeValue.
      Ajout du code 9 pour languagesSpokenCodeValue, maritalStatusCodeValue, genderCodeValue.
      Modifié le type de disabledCodeValue pour un entier 0, 1, 9.
      Ajout du code 8 pour actionPlanResultCodeValue.
      Ajout de simpleType indigenousIdentityCodeValue, immigrationStatusCodeValue, visibleMinorityCodeValue.
      , actionPlanPreviousEmploymentStatusCodeValue, actionPlanPrecariousEmploymentStatusCodeValue.
      , interventionCredentialCodeValue, interventionEssentialSkillsCodeValue, provincialOfficeTypeCode.
      Ajout de nouveaux codes pour interventionCodeValue 111, 112, 113, 114, 211, 212, 213, 214, 215, 221, 222, 223, 224, 311.
      Ajout de simpleType APEndDate.
      Ajout de plus de détails dans streetAddress concernant le numéro d'appartement.
      r1.4 2018-01-25     Changé le code postal pour qu'il accepte les lettres minuscules selon la tâche 163372. Modifié la description aussi.
      r1.5 2018-05-24     Ajouté l'option ''Inconnu'' à l'élément immigrationStatusCodeValue.
      Modifié l'option ''travailleur independant'' pour que le terme soit constant pour les éléments: actionPlanPreviousEmploymentCodeValue, actionPlanResultCodeValue.
      r1.6 2018-11-07     Modifié l'élément interventionCredentialCodeValue pour ajouter l'option "Ne s'applique pas".
      Modifié l'option "inconnu" pour inclure "À l'usage exclusif d'ETMT pendant la période de transition"
      Ajouté de l'information sur l'usage exclusif des éléments pour PMTA et ETMT.
      Ajouté de l'information sur les éléments obligatoires, pour quel programme (ETMT vs. PMTA), et si la validation est fait tu côté serveur.
      Modification de l'élément actionPlanPreviousEmploymentCode pour ajouter l'option "Inconnu".
      r1.7 2018-12-04     Modifié le type string au type token pour TRIM les espaces.
      Modifié "length.1-30" et changé son nom pour "basicLengthString".
      Modifié les éléments avec énumerations pour arrêter les éléments vides.
      Ajouté Inconnu à languagesSpokenCodeValue, interventionEssentialSkillsCodeValue, visibleMinorityCodeValue.
      Modifié actionPlanPreviousEmploymentCodeValue, added option 9.
      Ajouté l'élément scheduleTypeCodeValue.
      r1.8 2018-12-18     Ajouté 'inconnu' aux éléments: maritalStatusCodeValue, educationCodeValue.
      Changé 'aboriginal' pour 'indigenous' dans la documentation.
      Ajouté le type NOCVersionValue pour les éléments: actionPlanPreviousEmploymentNOCVersion, actionPlanResultRelatedNOCVersion, NOCVersion.
      Ajouté le type shortLengthString pour les éléments: actionPlanID, interventionID.
      Ajouté le type longLengthString pour les éléments: educationLevelComment, interventionTitle.
      r1.9 2019-01-10     Modifié actionPlanPreviousEmploymentCodeValue valeur 8 à 10 (inconnu).
      Simplifié les restrictions sur les éléments du schéma.
      r2.0 2019-01-17     Version finale pour ETMT et PMTA.
      r2.1 2019-02-18     Changé contactPhoneNumber à optionnel.
      r2.2 2019-05-10     Modifié sysComment valeur max à 100.
      Modifié systemType for sysAction.
      r2.3 2020-06-30     Correction dans le systemType.
      r2.4 2021-06-01     Modifié la validation du numéro de téléphone pour accepter les nouveaux numéros.
      r2.5 2021-07-20     Modifié les valeurs "inconnu" pour "non disponible".
      Ajouté la valeur "non disponible" aux éléments suivants: interventionCredentialCodeValue, provinceList, indigenousIdentityCodeValue.
      Ajouté option "Non disponible" à l'élément "disability"
      r2.6 2022-05-24		Ajouté option 2021 à l'élément "NOCVersionValue".
      Ajouté nouveau type "NOCValueCode".
      r2.6 2025-11-24		Ajouté option 'Work-sharing' aux éléments suivants: actionPlanResultCodeValue, actionPlanPreviousEmploymentCodeValue.
      Ajouté nouveau type actionPlanFundingSourceCodeValue.
      Ajouté nouveau type actionPlanFollowUpResultCodeValue.
      Ajouté nouveau type interventionCostCategoryCodeValue.
      Ajouté le type NAICSValueCode pour les éléments: actionPlanPreviousEmploymentNAICS, actionPlanTargetNAICS, actionPlanFollowUpNAICS.
      Ajouté le type NAICSVersionValue pour les éléments: actionPlanPreviousEmploymentNAICSVersion, actionPlanTargetNAICSVersion, actionPlanFollowUpNAICSVersion.
      Ajouté le type payRateValue pour les éléments: actionPlanPreviousEmploymentPayRate, actionPlanFollowUpEmploymentPayRate.
      Ajouté le type employmentHoursType pour les éléments: actionPlanPreviousEmploymentHours, actionPlanFollowUpEmploymentHours.
    </xsd:documentation>
	</xsd:annotation>
	<xsd:simpleType name="programTypeValue">
		<!-- For exclusive use by ILMP. \ À l'usage exclusif de PMTA. -->
		<xsd:restriction base="xsd:positiveInteger">
			<xsd:enumeration value="1">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">ASETS</xsd:documentation>
					<xsd:documentation xml:lang="fr-ca">SFCEA</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="3">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">SPF</xsd:documentation>
					<xsd:documentation xml:lang="fr-ca">FCP</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="4">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">FNJF: First Nation Job Fund</xsd:documentation>
					<xsd:documentation xml:lang="fr-ca">FEPN: Fonds pour l'emploi à l'intention des Premières Nations (FEPN)</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:whiteSpace value="collapse" />
			<xsd:minInclusive value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="NOCVersionValue">
		<xsd:restriction base="xsd:token">
			<!-- 0000. Not Available / 0000. Non disponible -->
			<xsd:pattern value="(0000)|(2006)|(2011)|(2016)|(2021)?" />
			<xsd:minLength value="1" />
			<xsd:maxLength value="4" />
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="shortLengthString">
		<xsd:restriction base="xsd:token">
			<xsd:minLength value="1" />
			<xsd:maxLength value="30" />
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="longLengthString">
		<xsd:restriction base="xsd:token">
			<xsd:minLength value="1" />
			<xsd:maxLength value="150" />
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
