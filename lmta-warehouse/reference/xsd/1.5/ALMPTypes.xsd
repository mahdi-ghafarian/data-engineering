	<xsd:simpleType name="addressProvince">
		<!-- This element is mandatory. Cet élément est obligatoire. -->
		<xsd:restriction base="xsd:positiveInteger">
			<xsd:enumeration value="13">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">United States</xsd:documentation>
					<xsd:documentation xml:lang="fr-ca">États-Unis</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="14">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">Other country</xsd:documentation>
					<xsd:documentation xml:lang="fr-ca">Autres pays</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:whiteSpace value="collapse" />
			<xsd:minInclusive value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="addressProvinceCodeValue">
		<!-- This element is mandatory. Cet élément est obligatoire. -->
		<xsd:union memberTypes="provinceList addressProvince" />
	</xsd:simpleType>
	<xsd:simpleType name="educationLocation">
		<!-- For exclusive use by ILMP. \ À l'usage exclusif de PMTA. -->
		<xsd:restriction base="xsd:positiveInteger">
			<xsd:enumeration value="14">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">Outside Canada</xsd:documentation>
					<!-- For exclusive use by ILMP. -->
					<xsd:documentation xml:lang="fr-ca">L'extérieur du Canada</xsd:documentation>
					<!-- À l'usage exclusif de PMTA. -->
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:whiteSpace value="collapse" />
			<xsd:minInclusive value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="educationProvinceCodeValue">
		<!-- For exclusive use by ILMP. \ À l'usage exclusif de PMTA. -->
		<xsd:union memberTypes="provinceList educationLocation" />
	</xsd:simpleType>
	<xsd:simpleType name="educationCodeValue">
		<!-- Mandatory for LMTA (will be validated on the server side). Obligatoire pour ETMT (sera validé côté serveur). -->
		<xsd:restriction base="xsd:positiveInteger">
			<xsd:enumeration value="1">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">No formal education</xsd:documentation>
					<!-- For exclusive use by ILMP. -->
					<xsd:documentation xml:lang="fr-ca">Pas d'éducation formelle</xsd:documentation>
					<!-- À l'usage exclusif de PMTA. -->
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="2">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">Up to grade 7-8 (Sec. I = Grade 8)</xsd:documentation>
					<!-- For exclusive use by ILMP. -->
					<xsd:documentation xml:lang="fr-ca">Jusqu'à 7-8 ans de scolarité (Sec. I = 8e année)</xsd:documentation>
					<!-- À l'usage exclusif de PMTA. -->
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="3">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">Grade 9-10 (Sec. II-III)</xsd:documentation>
					<!-- For exclusive use by ILMP. -->
					<xsd:documentation xml:lang="fr-ca">9-10 ans de scolarité (Sec. II-III)</xsd:documentation>
					<!-- À l'usage exclusif de PMTA. -->
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="4">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">Grade 11-12 (Sec. IV-V)</xsd:documentation>
					<!-- For exclusive use by ILMP. -->
					<xsd:documentation xml:lang="fr-ca">11-12 ans de scolarité (Sec. IV-V)</xsd:documentation>
					<!-- À l'usage exclusif de PMTA. -->
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="5">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">Secondary school diploma or GED</xsd:documentation>
					<xsd:documentation xml:lang="fr-ca">Diplôme d'études secondaires ou l'équivalent</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="6">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">Some post-secondary training</xsd:documentation>
					<xsd:documentation xml:lang="fr-ca">Études postsecondaires partielles</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="7">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">Apprenticeship or trades certificate or diploma</xsd:documentation>
					<!-- For exclusive use by ILMP. -->
					<xsd:documentation xml:lang="fr-ca">Certificat ou diplôme d'apprenti ou d'une école de métier</xsd:documentation>
					<!-- À l'usage exclusif de PMTA. -->
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="8">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">College, CEGEP, or other non-university certificate or diploma</xsd:documentation>
					<xsd:documentation xml:lang="fr-ca">Certificat ou diplôme d'un collège, d'un cégep ou d'un autre établissement</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="9">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">University certificate or diploma</xsd:documentation>
					<xsd:documentation xml:lang="fr-ca">Certificat ou diplôme universitaire</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="10">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">University - Bachelor degree</xsd:documentation>
					<!-- For exclusive use by ILMP. -->
					<xsd:documentation xml:lang="fr-ca">Université - Baccalauréat</xsd:documentation>
					<!-- À l'usage exclusif de PMTA. -->
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="11">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">University - Master's degree</xsd:documentation>
					<!-- For exclusive use by ILMP. -->
					<xsd:documentation xml:lang="fr-ca">Université - Maîtrise</xsd:documentation>
					<!-- À l'usage exclusif de PMTA. -->
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="12">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">University - Doctorate</xsd:documentation>
					<!-- For exclusive use by ILMP. -->
					<xsd:documentation xml:lang="fr-ca">Université - Doctorat</xsd:documentation>
					<!-- À l'usage exclusif de PMTA. -->
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="13">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">Less than high school</xsd:documentation>
					<!-- For exclusive use by LMTA. -->
					<xsd:documentation xml:lang="fr-ca">Sans diplôme d'études secondaires</xsd:documentation>
					<!-- À l'usage exclusif d'ETMT. -->
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="14">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">University degree</xsd:documentation>
					<!-- For exclusive use by LMTA. -->
					<xsd:documentation xml:lang="fr-ca">Diplôme universitaire</xsd:documentation>
					<!-- À l'usage exclusif d'ETMT. -->
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="15">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">Other</xsd:documentation>
					<!-- For exclusive use by LMTA. -->
					<xsd:documentation xml:lang="fr-ca">Autre</xsd:documentation>
					<!-- À l'usage exclusif d'ETMT. -->
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="98">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">Not Available</xsd:documentation>
					<!-- For exclusive use by LMTA during the transition period. -->
					<xsd:documentation xml:lang="fr-ca">Non disponible</xsd:documentation>
					<!-- À l'usage exclusif d'ETMT pendant la période de transition. -->
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="99">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">Prefer not to report</xsd:documentation>
					<!-- For exclusive use by LMTA. -->
					<xsd:documentation xml:lang="fr-ca">Préfère ne pas déclarer</xsd:documentation>
					<!-- À l'usage exclusif d'ETMT. -->
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:whiteSpace value="collapse" />
			<xsd:minInclusive value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="languagesSpokenCodeValue">
		<!-- Mandatory for LMTA (will be validated on the server side). Obligatoire pour ETMT (sera validé côté serveur). -->
		<xsd:restriction base="xsd:positiveInteger">
			<xsd:enumeration value="1">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">Indigenous language(s) only</xsd:documentation>
					<!-- For exclusive use by ILMP. -->
					<xsd:documentation xml:lang="fr-ca">Langue autochtone(s) seulement</xsd:documentation>
					<!-- À l'usage exclusif de PMTA. -->
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="2">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">English only</xsd:documentation>
					<xsd:documentation xml:lang="fr-ca">Anglais seulement</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:enumeration value="3">
