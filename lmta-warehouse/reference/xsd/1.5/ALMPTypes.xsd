		<xsd:annotation>
			<xsd:documentation xml:lang="en-CA">Reserved for use by automation solution providers.</xsd:documentation>
			<xsd:documentation xml:lang="fr-CA">Réservé pour une utilisation par des fournisseurs de solutions d'automatisation.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:minLength value="1" />
			<xsd:maxLength value="100" />
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="basicLengthString">
		<xsd:annotation>
			<xsd:documentation xml:lang="en-CA">
				Derived from 'string' 1-100 length.
				Line feeds, carriage returns, tabs, leading and trailing spaces, and multiple spaces are removed.
			</xsd:documentation>
			<xsd:documentation xml:lang="fr-CA">
				Dérivé de 'chaine' 1-100 longueur.
				Sauts de lignes, retour chariot, tabulations, espaces avant et après, et plusieurs espaces sont supprimés.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:minLength value="1" />
			<xsd:maxLength value="100" />
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="SIN">
		<!-- This element is mandatory. Cet élément est obligatoire. -->
		<xsd:annotation>
			<xsd:documentation xml:lang="en-CA">Social insurance number</xsd:documentation>
			<xsd:documentation xml:lang="fr-CA">Numéro d'assurance sociale</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:pattern value="\d{9}" />
			<xsd:whiteSpace value="collapse"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="agreementNumber">
		<!-- This element is mandatory. Cet élément est obligatoire. -->
		<xsd:annotation>
			<xsd:documentation xml:lang="en-CA">Agreement number</xsd:documentation>
			<xsd:documentation xml:lang="fr-CA">Numéro d'entente</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:pattern value="\d{7,9}" />
			<xsd:whiteSpace value="collapse" />
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="APStartDate">
		<!-- Mandatory for LMTA (will be validated on the server side). Obligatoire pour ETMT (sera validé côté serveur). -->
		<xsd:annotation>
			<xsd:documentation xml:lang="en-CA">Start date of the action plan.</xsd:documentation>
			<xsd:documentation xml:lang="fr-CA">Date de début du plan d'action.</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:date" />
	</xsd:simpleType>
	<xsd:simpleType name="APEndDate">
		<!-- For exclusive use by LMTA. / À l'usage exclusif d'ETMT. -->
		<xsd:annotation>
			<xsd:documentation xml:lang="en-CA">End date of the action plan</xsd:documentation>
			<xsd:documentation xml:lang="fr-CA">Date de fin du plan d'action</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:date" />
	</xsd:simpleType>
	<xsd:simpleType name="systemActionType">
		<xsd:restriction base="xsd:positiveInteger">
			<xsd:annotation>
				<xsd:documentation xml:lang="en-CA">
					Specifies a non-interactive system action to undertake.
					Supported Actions:
					Expire = Data is logically removed to correct orphaned or deadlock instances.
				</xsd:documentation>
				<xsd:documentation xml:lang="fr-CA">
					Indique une action système non-interactif à entreprendre.
					Actions soutenus:
					Expirer = est logiquement supprimée afin de corriger les cas de blocage ou d'orphelins.
				</xsd:documentation>
			</xsd:annotation>
			<xsd:enumeration value="1">
				<xsd:annotation>
					<xsd:documentation xml:lang="en-ca">Expire</xsd:documentation>
					<xsd:documentation xml:lang="fr-ca">Expirer</xsd:documentation>
				</xsd:annotation>
			</xsd:enumeration>
			<xsd:whiteSpace value="collapse" />
			<xsd:minInclusive value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="addressType">
		<xsd:annotation>
			<xsd:documentation xml:lang="en-CA">
				Contains geo-location (mailing address) and phone number.
				Where appropriate, TBITS Addressing Standard - Attribute Matrix and wikipedia were used as reference.

				The mailing address is used as an address that specifies where mail is to be delivered
				and that includes information assigned by the municipality and building owners, as well as
				the assigned Postal Code and other related address information assigned by Canada Post, as required.
				Note: This type of address can be different from the physical or street address.
			</xsd:documentation>
			<xsd:documentation xml:lang="fr-CA">
				Contient géo-localisation (adresse postale) et numéro de téléphone.
				Le cas échéant, NCTTI adressage standard - Attribut Matrix et wikipedia ont été utilisés comme référence.

				L'adresse postale est utilisée comme une adresse où le courrier doit être livré et qui comprend
				les renseignements attribués par la municipalité et les propriétaires d'immeubles, ainsi que
				le code postale et toutes autres informations assignées par Postes Canada, au besoin.
				Note: Ce type d'adresse peut être différent de l'adresse physique ou l'adresse de la rue.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:element name="streetAddress">
				<!-- This element is mandatory. Cet élément est obligatoire. -->
				<xsd:annotation>
					<xsd:documentation xml:lang="en-CA">
						Specifies a unique location on a street, roadway, or artery within
						a municipality, based on identification information provided by
						municipal and/or officially recognized authorities. May also be a
						postal office box (i.e. PO Box or postal box).
						If an apartment number exists, add it before the street number and street name.
						These two numeric elements will be separated by a hyphen (e.g. 7-22 Eddy Street).
						If the client does not have an address, the token “No Address” must be used.
						* Pattern constraint serves to document the use of the "No Address/Pas d'adresse" tokens.
						Max: 150 characters.
					</xsd:documentation>
					<xsd:documentation xml:lang="fr-CA">
						Indique un endroit précis sur une rue, un chemin ou une artère dans
						une municipalité basé sur l'information fournie par l'autorité
						municipale et/ou par un parti officiellement reconnu. Peut aussi
						être une case postale (i.e. CP).
						Si un numéro d'appartement existe, ajoutez celui-ci devant le numéro municipal et le nom de la rue.
						Ces deux éléments numériques seront séparés par un trait d'union (ex. 7-22 rue Eddy).
						Si le client n'a pas d'adresse, veuillez inscrire dans le champ "Pas d'adresse".
						Max: 150 caractères.
					</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:token">
						<xsd:minLength value="2" />
						<xsd:maxLength value="150" />
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="municipality">
				<!-- This element is mandatory. Cet élément est obligatoire. -->
				<xsd:annotation>
					<xsd:documentation xml:lang="en-CA">
						An area commonly recognized as constituting a town, village, city,
						(i.e. an official municipality), or a local area that is
						generally deemed locally to have the status of an official
						municipality or reserve.
						If the client does not have a city, the city of the organization may
						be used.
						Max: 100 characters.
					</xsd:documentation>
					<xsd:documentation xml:lang="fr-CA">
						Un endroit qui est reconnu comme étant un village, une ville, une
						municipalité reconnu ou un endroit qui est généralement reconnu
						comme étant une municipalité ou réserve officielle.
						Si le client n'a pas d'adresse, la ville où l'organisation est
						située doit être inscrite dans ce champ.
						Max: 100 caractères.
					</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:token">
						<xsd:minLength value="3" />
						<xsd:maxLength value="100" />
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="province" type="addressProvinceCodeValue">
				<!-- This element is mandatory. Cet élément est obligatoire. -->
				<xsd:annotation>
					<xsd:documentation xml:lang="en-CA">
						Specifies the client's province or country of residence. If the
						client does not have an address, provide organization's province.
					</xsd:documentation>
					<xsd:documentation xml:lang="fr-CA">
						Indique la province ou le pays de résidence du client. Si le client
						n'a pas d'adresse, veuillez inscrire la province où l'organisation
						est située.
					</xsd:documentation>
				</xsd:annotation>
			</xsd:element>
			<xsd:element name="postalZIPCode">
				<!-- Mandatory for LMTA (will be validated on the server side). Obligatoire pour ETMT (sera validé côté serveur). -->
				<xsd:annotation>
					<xsd:documentation xml:lang="en-CA">
						Specifies the client's postal code (may be outside Canada). A code
						used by various postal authorities in the world (zip code in the
						USA) to identify a relatively small (10-1,000 people) delivery
						location.
						The postal code is not case-sensitive (e.g. a1a1a1 and A1A1A1 are considered the same thing).
						Where the client is homeless (i.e. client has no address and postal
						code), the token "No Postal Code" must be used.
					</xsd:documentation>
					<xsd:documentation xml:lang="fr-CA">
						Indique le code postal (peut être à l'extérieur du Canada) du
						client. Il s'agit d'un code utilisé par les autorités postales dans
						le monde (code ZIP aux É.-U.) pour identifier les petites (10 –
						1000 personne) zones de livraison.
						Le code postal n'est pas sensible aux lettres minuscules ou majuscules (ex.: a1a1a1 et A1A1A1 veulent dire la même chose).
						Si le client n'a pas d'adresse et de code postal, veuillez inscrire
						"Pas de code postal" dans le champ.
					</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:token">
						<xsd:pattern
						  value="[AaBbCcEeGgHhJjKkLlMmNnPpRrSsTtVvXxYy]\d[a-zA-Z]\d[a-zA-Z]\d|\d{5,9}|No Postal Code|Pas de code postal" />
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="contactPhoneNumber" minOccurs="0">
				<!-- Mandatory for LMTA (will be validated on the server side). Obligatoire pour ETMT (sera validé côté serveur). -->
				<xsd:annotation>
					<xsd:documentation xml:lang="en-CA">
						Specifies the client's telephone number If the client does not have a
						telephone number, than the token "No Telephone" must be used.
						The North American Numbering Plan (NANP) covering 24 countries and
						territories: the United States and its territories, Canada,
						Bermuda, and 16 of the Caribbean countries. Also, includes an
						additional 4 digits for the extension (optional) for total of
						15 digits.
					</xsd:documentation>
					<xsd:documentation xml:lang="fr-CA">
						Spécifie le numéro de téléphone du client. Si le client n'a pas de numéro
						de téléphone, veuillez inscrire "Pas de téléphone" dans le champ.
						Le plan de numérotage nord-américain (NANP) couvre 24 pays et
						territoires:
						les États-Unis et ces territoires, le Canada, les Bermudes, et
						les 16 pays des Caraïbes. De plus, il est possible d'ajouter 4
						chiffres qui composent l'extension (optionnelle) pour un total
						de 15 chiffres.
					</xsd:documentation>
				</xsd:annotation>
				<xsd:simpleType>
					<xsd:restriction base="xsd:token">
						<xsd:pattern value="(Pas de téléphone)|(No Telephone)|(Not Available)|(Non disponible)|(\d{1}-)?\(?\d{3}\)?[\-]\d{3}[\-]\d{4}(:\d{1,4})?" />
					</xsd:restriction>
				</xsd:simpleType>
			</xsd:element>
			<xsd:element name="sysComment" type="sysComment" minOccurs="0"></xsd:element>
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="provincialOfficeTypeCode">
		<!-- Mandatory for LMTA (will be validated on the server side). Obligatoire pour ETMT (sera validé côté serveur). -->
		<xsd:restriction base="xsd:token">
			<xsd:minLength value="1"/>
			<xsd:maxLength value="15"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:complexType name="systemType">
		<xsd:annotation>
			<xsd:documentation xml:lang="en-CA">
				All information related to the intervention, the action plan or the client
				will also be 'logically' removed. This feature is intended to better support
				data salvage efforts by providing a means whereby certain 'deadlock' or 'orphan'
				cases can be resolved without directly involving the program area. It is not to
				be used in a casual manner by the case manager in a operational context.
			</xsd:documentation>
			<xsd:documentation xml:lang="fr-CA">
				Toutes les informations relatives à l'intervention, le plan d'action ou le client seront
				aussi 'logiquement' enlevé. Cette fonctionnalité est destinée à mieux soutenir les efforts
				de récupération de données en fournissant un moyen par lequel certaines «impasse» ou des cas
				«orphelins» peuvent être résolus sans la participation directe de la zone du programme.
				Il ne doit pas être utilisé d'une manière occasionnelle par le gestionnaire de cas dans un
				contexte opérationnel.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:sequence>
			<xsd:choice>
				<xsd:element name="socialInsuranceNumber" type="SIN" />
				<xsd:element name="clientID" type="shortLengthString" />
			</xsd:choice>
			<xsd:sequence>
				<xsd:element name="agreementNumber" type="agreementNumber" />
			</xsd:sequence>
			<xsd:sequence minOccurs="0">
				<xsd:element name="actionPlanStartDate" type="APStartDate" />
			</xsd:sequence>
			<xsd:sequence minOccurs="0">
				<xsd:element name="interventionStartDate" type="xsd:date" />
				<xsd:element name="interventionCode" type="interventionCodeValue" />
			</xsd:sequence>
			<xsd:sequence minOccurs="0">
				<xsd:element name="actionPlanID" type="shortLengthString" minOccurs="0" />
				<xsd:element name="interventionID" type="shortLengthString" minOccurs="0" />
			</xsd:sequence>
			<xsd:element name="systemAction" type="systemActionType" />
			<xsd:element name="sysComment" type="sysComment" minOccurs="0" />
		</xsd:sequence>
	</xsd:complexType>
	<xsd:simpleType name="NOCValueCode">
		<xsd:annotation>
			<xsd:documentation xml:lang="en-CA">
				Used to validate the NOC value elements.
			</xsd:documentation>
			<xsd:documentation xml:lang="fr-CA">
				Utilisé pour valider les éléments du NAS.
			</xsd:documentation>
		</xsd:annotation>
		<xsd:restriction base="xsd:token">
			<xsd:minLength value="1" />
			<xsd:pattern value="\d{4,5}" />
		</xsd:restriction>
	</xsd:simpleType>
  <xsd:simpleType name="actionPlanFundingSourceCodeValue">
    <!-- Mandatory for LMTA (will be validated on the server side). Obligatoire pour ETMT (sera validé côté serveur). -->
    <xsd:restriction base="xsd:positiveInteger">
      <xsd:enumeration value="1">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Steel Tariffs</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Tarifs acier</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="2">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Softwood Lumber Tariffs</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Tarifs bois d’oeuvre résineux</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="3">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Comprehensive Tariffs</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Tarifs soutien complet</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="8">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Not Applicable</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Ne s'applique pas</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:whiteSpace value="collapse" />
      <xsd:minInclusive value="1"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="actionPlanFollowUpResultCodeValue">
    <!-- For exclusive use by LMTA. / À l'usage exclusif pour ETMT. -->
    <!-- Mandatory when actionPlanFundingSource  is '1. Steel Tariffs', '2. Softwood Lumber Tariffs' or '3. Comprehensive Tariffs'
												and actionPlanFollowUpDate is provided (will be validated on the server side).
    Obligatoire lorsque actionPlanFundingSource est '1. Tarifs sur l’acier', '2. Tarifs sur le bois d’œuvre résineux' ou '3. Tarifs globaux' (sera validé côté serveur).
												et actionPlanFollowUpDate est fourni (sera validé côté serveur).-->
    <xsd:restriction base="xsd:positiveInteger">
      <xsd:enumeration value="1">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Unemployed but available for work</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Sans emploi mais disponible pour travailler</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="2">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Employed</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">À l'emploi</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="3">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Self-employed</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Travailleur indépendant</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="4">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Returned to School</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Retourné à l'école</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="5">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Unspecified – participant could not be reached</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Non spécifié – le participant n’a pu être contacté</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="6">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Not in labour force</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Pas dans la population active</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="7">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Work-sharing</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Travail partagé</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="8">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Starting a new action plan</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Début d'un nouveau plan d'action </xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:whiteSpace value="collapse" />
      <xsd:minInclusive value="1"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="interventionCostCategoryCodeValue">
    <!-- For exclusive use by LMTA. / À l'usage exclusif pour ETMT. -->
    <!-- Mandatory when actionPlanResultDate or the interventionEndDate is provided
								and when actionPlanFundingSource  is '1. Steel Tariffs', '2. Softwood Lumber Tariffs' or '3. Comprehensive Tariffs'
                and when interventionCost is provided 
								(will be validated on the server side).
    Obligatoire lorsque actionPlanResultDate ou interventionEndDate est fourni
								et actionPlanFundingSource est '1. Tarifs sur l’acier', '2. Tarifs sur le bois d’œuvre résineux' ou '3. Tarifs globaux' (sera validé côté serveur).
								et interventionCost est fourni
								(sera validé côté serveur).-->
    <xsd:restriction base="xsd:integer">
      <xsd:enumeration value="0">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Not applicable</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Ne s'applique pas</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="1">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Transportation</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Transport</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="2">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Dependent support</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Soutien pour les personnes à charge</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="3">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Accommodations</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Hébergement</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="4">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Disability support</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Soutien à la stabilité</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="5">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Mental Health support</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Soutien en santé mentale</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="6">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Supplies support</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Soutien pour la fourniture</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="7">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Mobility relocation may be required</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Relocalisation pour mobilité peut être requise </xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="8">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Tuition fees</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Frais de scolarité</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:enumeration value="10">
        <xsd:annotation>
          <xsd:documentation xml:lang="en-ca">Other</xsd:documentation>
          <xsd:documentation xml:lang="fr-ca">Autre</xsd:documentation>
        </xsd:annotation>
      </xsd:enumeration>
      <xsd:whiteSpace value="collapse" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="NAICSValueCode">
    <xsd:annotation>
        <!-- 000000. Not Available / 000000. Non disponible -->
      <xsd:documentation xml:lang="en-CA">
        Used to validate the NAICS value elements.
      </xsd:documentation>
      <xsd:documentation xml:lang="fr-CA">
        Utilisé pour valider les éléments du NAICS.
      </xsd:documentation>
    </xsd:annotation>
    <xsd:restriction base="xsd:token">
      <xsd:pattern value="\d{3,6}" />
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="NAICSVersionValue">
    <xsd:restriction base="xsd:token">
      <!-- 0000. Not Available / 0000. Non disponible -->
      <xsd:pattern value="(0000)|(2017)|(2022)?" />
      <xsd:minLength value="1" />
      <xsd:maxLength value="4" />
      <xsd:whiteSpace value="collapse"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="payRateValue">
    <xsd:restriction base="xsd:string">
      <!-- Restricts the lexical representation -->
      <xsd:pattern value="\d{4,6}"/>
    </xsd:restriction>
  </xsd:simpleType>
  <xsd:simpleType name="employmentHoursType">
    <xsd:restriction base="xsd:string">
      <!-- Restricts the lexical representation -->
      <xsd:pattern value="(168|([1-9]|[1-9][0-9]|1[0-5][0-9]|16[0-7])([.,]5)?)" />
    </xsd:restriction>
