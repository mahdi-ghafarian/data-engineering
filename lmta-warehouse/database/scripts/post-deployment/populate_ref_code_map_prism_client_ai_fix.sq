/*
    Complete PRISM client mappings in ref.code_map.

    Assumptions:
    - Client demographic mappings apply to both LMDA and WDA.
    - ref.code_map already contains the columns shown in your result.
    - All mappings start on 2026-04-15.
*/


/* ------------------------------------------------------------
   1. Standardize existing client mappings to BOTH
------------------------------------------------------------ */

UPDATE ref.code_map
SET almp_program_type = 'BOTH'
WHERE source_system = 'PRISM_CLT'
  AND source_table = 'contact'
  AND almp_schema_version = '1.5'
  AND almp_element_name IN
  (
      'gender',
      'maritalStatus',
      'languageSpoken',
      'disability',
      'indigenousIdentity',
      'immigrant',
      'visibleMinority'
  )
  AND almp_program_type = 'LMTA';


/* ------------------------------------------------------------
   2. Derive mappings from actual PRISM choice values
------------------------------------------------------------ */

WITH source_mapping AS
(
    SELECT DISTINCT
        CAST('PRISM_CLT' AS VARCHAR(50))
            COLLATE Latin1_General_100_BIN2_UTF8 AS source_system,

        CAST('contact' AS VARCHAR(100))
            COLLATE Latin1_General_100_BIN2_UTF8 AS source_table,

        LOWER(pc.COLUMN_NAME)
            COLLATE Latin1_General_100_BIN2_UTF8 AS source_column,

        CAST(pc.CHOICE_VALUE AS VARCHAR(200))
            COLLATE Latin1_General_100_BIN2_UTF8 AS source_value,

        CAST(pc.CHOICE_NAME AS VARCHAR(500))
            COLLATE Latin1_General_100_BIN2_UTF8 AS source_label,

        CASE LOWER(pc.COLUMN_NAME)

            WHEN 'gendercode'
                THEN 'gender'

            WHEN 'familystatuscode'
                THEN 'maritalStatus'

            WHEN 'ict_languageofservices'
                THEN 'languageSpoken'

            WHEN 'ict_disability'
                THEN 'disability'

            WHEN 'ict_indigenousidentity'
                THEN 'indigenousIdentity'

            WHEN 'ict_citizenshipimmigrationstatus'
                THEN 'immigrant'

            WHEN 'ict_visibleminority'
                THEN 'visibleMinority'

        END COLLATE Latin1_General_100_BIN2_UTF8
            AS almp_element_name,

        CASE

            /* ---------------- Gender ---------------- */

            WHEN LOWER(pc.COLUMN_NAME) = 'gendercode'
             AND LOWER(pc.CHOICE_NAME) = 'male'
                THEN '1'

            WHEN LOWER(pc.COLUMN_NAME) = 'gendercode'
             AND LOWER(pc.CHOICE_NAME) = 'female'
                THEN '2'

            WHEN LOWER(pc.COLUMN_NAME) = 'gendercode'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'unspecified',
                     'unknown',
                     'other'
                 )
                THEN '3'

            WHEN LOWER(pc.COLUMN_NAME) = 'gendercode'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'prefer not to respond',
                     'prefer not to answer',
                     'prefer not to disclose',
                     'prefer not to say',
                     'prefer not to report',
                     'declined'
                 )
                THEN '9'


            /* ---------------- Marital status ---------------- */

            WHEN LOWER(pc.COLUMN_NAME) = 'familystatuscode'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'married',
                     'common law',
                     'common-law',
                     'partnered'
                 )
                THEN '1'

            WHEN LOWER(pc.COLUMN_NAME) = 'familystatuscode'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'single',
                     'divorced',
                     'separated',
                     'widowed'
                 )
                THEN '2'

            WHEN LOWER(pc.COLUMN_NAME) = 'familystatuscode'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'prefer not to respond',
                     'prefer not to answer',
                     'prefer not to disclose',
                     'prefer not to report',
                     'declined'
                 )
                THEN '9'


            /* ---------------- Language spoken ---------------- */

            WHEN LOWER(pc.COLUMN_NAME) = 'ict_languageofservices'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'english',
                     'english only'
                 )
                THEN '2'

            WHEN LOWER(pc.COLUMN_NAME) = 'ict_languageofservices'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'french',
                     'french only'
                 )
                THEN '3'

            WHEN LOWER(pc.COLUMN_NAME) = 'ict_languageofservices'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'english and french',
                     'english & french',
                     'bilingual'
                 )
                THEN '6'

            WHEN LOWER(pc.COLUMN_NAME) = 'ict_languageofservices'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'other',
                     'other language',
                     'neither',
                     'not a federal official language'
                 )
                THEN '9'


            /* ---------------- Disability ---------------- */

            WHEN LOWER(pc.COLUMN_NAME) = 'ict_disability'
             AND LOWER(pc.CHOICE_NAME) = 'yes'
                THEN '1'

            WHEN LOWER(pc.COLUMN_NAME) = 'ict_disability'
             AND LOWER(pc.CHOICE_NAME) = 'no'
                THEN '2'

            WHEN LOWER(pc.COLUMN_NAME) = 'ict_disability'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'prefer not to respond',
                     'prefer not to answer',
                     'prefer not to disclose',
                     'prefer not to report',
                     'declined',
                     'unknown'
                 )
                THEN '9'


            /* ---------------- Indigenous identity ---------------- */

            WHEN LOWER(pc.COLUMN_NAME) = 'ict_indigenousidentity'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'first nations',
                     'first nation',
                     'metis',
                     'métis',
                     'inuit',
                     'indigenous',
                     'yes'
                 )
                THEN '1'

            WHEN LOWER(pc.COLUMN_NAME) = 'ict_indigenousidentity'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'no',
                     'non-indigenous',
                     'not indigenous'
                 )
                THEN '2'

            WHEN LOWER(pc.COLUMN_NAME) = 'ict_indigenousidentity'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'prefer not to respond',
                     'prefer not to answer',
                     'prefer not to disclose',
                     'prefer not to report',
                     'declined',
                     'unknown'
                 )
                THEN '9'


            /* ---------------- Immigrant status ---------------- */

            WHEN LOWER(pc.COLUMN_NAME) =
                 'ict_citizenshipimmigrationstatus'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'permanent resident',
                     'landed immigrant',
                     'immigrant',
                     'protected person',
                     'refugee',
                     'convention refugee',
                     'yes'
                 )
                THEN '1'

            WHEN LOWER(pc.COLUMN_NAME) =
                 'ict_citizenshipimmigrationstatus'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'canadian citizen',
                     'citizen',
                     'born in canada',
                     'non-immigrant',
                     'no'
                 )
                THEN '2'

            WHEN LOWER(pc.COLUMN_NAME) =
                 'ict_citizenshipimmigrationstatus'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'prefer not to respond',
                     'prefer not to answer',
                     'prefer not to disclose',
                     'prefer not to report',
                     'declined',
                     'unknown'
                 )
                THEN '9'


            /* ---------------- Visible minority ---------------- */

            WHEN LOWER(pc.COLUMN_NAME) = 'ict_visibleminority'
             AND LOWER(pc.CHOICE_NAME) = 'yes'
                THEN '1'

            WHEN LOWER(pc.COLUMN_NAME) = 'ict_visibleminority'
             AND LOWER(pc.CHOICE_NAME) = 'no'
                THEN '2'

            WHEN LOWER(pc.COLUMN_NAME) = 'ict_visibleminority'
             AND LOWER(pc.CHOICE_NAME) IN
                 (
                     'prefer not to respond',
                     'prefer not to answer',
                     'prefer not to disclose',
                     'prefer not to report',
                     'declined',
                     'unknown'
                 )
                THEN '9'

        END COLLATE Latin1_General_100_BIN2_UTF8
            AS almp_code

    FROM stg.prism_choice AS pc

    WHERE LOWER(pc.MODULE_NAME)
              COLLATE Latin1_General_100_BIN2_UTF8
          = 'client'

      AND LOWER(pc.TABLE_NAME)
              COLLATE Latin1_General_100_BIN2_UTF8
          = 'contact'

      AND LOWER(pc.COLUMN_NAME)
              COLLATE Latin1_General_100_BIN2_UTF8
          IN
          (
              'gendercode',
              'familystatuscode',
              'ict_languageofservices',
              'ict_disability',
              'ict_indigenousidentity',
              'ict_citizenshipimmigrationstatus',
              'ict_visibleminority'
          )
)

INSERT INTO ref.code_map
(
    source_system,
    source_table,
    source_column,
    source_value,
    source_label,
    almp_element_name,
    almp_code,
    almp_program_type,
    almp_schema_version,
    effective_from,
    effective_to,
    mapping_note
)
SELECT
    mapping.source_system,
    mapping.source_table,
    mapping.source_column,
    mapping.source_value,
    mapping.source_label,
    mapping.almp_element_name,
    mapping.almp_code,

    'BOTH' AS almp_program_type,
    '1.5'  AS almp_schema_version,

    CAST('2026-04-15' AS DATE) AS effective_from,
    NULL AS effective_to,

    'PRISM client mapping assigned from reviewed source-label meaning.'
        AS mapping_note

FROM source_mapping AS mapping

WHERE mapping.almp_code IS NOT NULL

  AND NOT EXISTS
  (
      SELECT 1
      FROM ref.code_map AS existing

      WHERE existing.source_system = mapping.source_system

        AND
        (
            existing.source_table = mapping.source_table
            OR
            (
                existing.source_table IS NULL
                AND mapping.source_table IS NULL
            )
        )

        AND existing.source_column =
            mapping.source_column

        AND existing.source_value =
            mapping.source_value

        AND existing.almp_element_name =
            mapping.almp_element_name

        AND existing.almp_schema_version = '1.5'
  );


/* ------------------------------------------------------------
   3. Show the completed client mapping set
------------------------------------------------------------ */

SELECT
    source_system,
    source_table,
    source_column,
    source_value,
    source_label,
    almp_element_name,
    almp_code,
    almp_program_type,
    almp_schema_version,
    effective_from,
    effective_to,
    mapping_note

FROM ref.code_map

WHERE source_system = 'PRISM_CLT'
  AND source_table = 'contact'
  AND almp_schema_version = '1.5'

ORDER BY
    almp_element_name,
    source_column,
    source_label;